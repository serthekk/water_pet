{
  "name": "water-cat-tracker",
  "productName": "WaterCat",
  "version": "1.0.2",
  "description": "A pixel cat on your Windows desktop that reminds you to drink water",
  "main": "main.js",
  "author": "serthekk",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/serthekk/water_pet.git"
  },
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "sprite": "node render_sprite.js",
    "meows": "node make_meows.js",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check catsprite.js && node --check render_sprite.js",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "version:patch": "npm version patch -m \"Release v%s\"",
    "version:minor": "npm version minor -m \"Release v%s\"",
    "update-test-server": "node tools/update-test-server.js"
  },
  "build": {
    "appId": "com.serthekk.waterpet",
    "productName": "WaterCat",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "fullscreen.js",
      "preload.js",
      "renderer.js",
      "catsprite.js",
      "index.html",
      "styles.css",
      "settings.html",
      "settings.css",
      "settings.js",
      "settings-preload.js",
      "customize.html",
      "customize.css",
      "customize.js",
      "customize-preload.js",
      "info.html",
      "info.css",
      "info.js",
      "info-preload.js",
      "menu.html",
      "menu.css",
      "menu.js",
      "menu-preload.js",
      "catcher.html",
      "catcher.js",
      "notes.html",
      "notes.css",
      "notes.js",
      "notes-preload.js",
      "release-notes.json",
      "feedback.html",
      "feedback.css",
      "feedback.js",
      "feedback-preload.js",
      "stats.html",
      "stats.css",
      "stats.js",
      "stats-preload.js",
      "play.html",
      "play.css",
      "play.js",
      "play-preload.js",
      "themes.js",
      "drinks.js",
      "tooltip.js",
      "assets/cat_pixel.png",
      "assets/tray.png",
      "assets/bowl.png",
      "assets/meows/*.wav",
      "assets/meows/meows.json",
      "package.json",
      "!assets/reference/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "serthekk",
        "repo": "water_pet",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.0",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}

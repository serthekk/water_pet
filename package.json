{
  "name": "water-cat-tracker",
  "productName": "WaterCat",
  "version": "1.0.0",
  "description": "Minimal desktop pet water tracker",
  "main": "main.js",
  "author": "WaterCat",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "sprite": "node render_sprite.js",
    "meows": "node make_meows.js",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check render_sprite.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.watercat.tracker",
    "productName": "WaterCat",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "catsprite.js",
      "index.html",
      "styles.css",
      "settings.html",
      "settings.css",
      "settings.js",
      "settings-preload.js",
      "customize.html",
      "customize.css",
      "customize.js",
      "customize-preload.js",
      "info.html",
      "info.css",
      "info.js",
      "info-preload.js",
      "assets/cat_pixel.png",
      "assets/tray.png",
      "assets/bowl.png",
      "assets/meows/*.wav",
      "assets/meows/meows.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WaterCat-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WaterCat-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.0.0",
    "pngjs": "^7.0.0"
  }
}
